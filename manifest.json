{
  "manifest_version": 3,
  "name": "Sidebar for YouTube Music",
  "version": "1.0.1",
  "description": "YouTube Music remote in the Firefox sidebar: playlists, library, queue, search and lyrics, with playback that survives closing it.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ytmusic-sidebar@fabiosammy",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "tabHide",
    "notifications"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "Sidebar for YouTube Music",
    "default_panel": "src/sidebar.html",
    "default_icon": "icons/icon.svg"
  },
  "action": {
    "default_title": "YouTube Music",
    "default_popup": "src/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "src/player.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://github.com/fabiosammy/ytmusic-sidebar-firefox"
}
