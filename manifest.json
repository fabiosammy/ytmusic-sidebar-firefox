{
  "manifest_version": 3,
  "name": "YouTube Music Sidebar",
  "version": "0.1.0",
  "description": "YouTube Music in the Firefox sidebar: your playlists, library and player, signed in with your account.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ytmusic-sidebar@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "YouTube Music",
    "default_panel": "src/sidebar.html",
    "default_icon": "icons/icon.svg"
  },
  "action": {
    "default_title": "Open YouTube Music sidebar",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      }
    },
    "play-pause": {
      "suggested_key": {
        "default": "MediaPlayPause"
      },
      "description": "Play/pause YouTube Music in the sidebar"
    },
    "next-track": {
      "suggested_key": {
        "default": "MediaNextTrack"
      },
      "description": "Next song"
    },
    "previous-track": {
      "suggested_key": {
        "default": "MediaPrevTrack"
      },
      "description": "Previous song"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "src/frame.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
