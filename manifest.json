{
  "manifest_version": 3,
  "name": "YouTube Music Sidebar",
  "version": "0.1.0",
  "description": "A YouTube Music remote in the Firefox sidebar. Music plays in one hidden tab, keeps going when the sidebar closes, and works with your media keys.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ytmusic-sidebar@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "tabHide",
    "notifications"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "YouTube Music",
    "default_panel": "src/sidebar.html",
    "default_icon": "icons/icon.svg"
  },
  "action": {
    "default_title": "Open YouTube Music sidebar",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "src/player.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
